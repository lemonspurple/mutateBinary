<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:deepMutate.ViewModels"
        x:Class="deepMutate.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="deepMutate 0.1"
        Icon="/Assets/logo.ico"
        Width="600" Height="450">

    <StackPanel Margin="20" Spacing="10">
        
        <TextBlock Text="deepMutate 0.1" FontSize="18" FontWeight="Bold"/>

        <Button Content="Select folder..." 
                Command="{Binding PickFolderCommand}" 
                Background="DarkSlateBlue" Foreground="White" />

        <TextBlock Text="Current directory:" FontWeight="Bold"/>
        <TextBlock Text="{Binding SelectedFolderPath}" Foreground="Gray" TextWrapping="Wrap"/>

        <Separator/>

        <TextBlock Text="Data found:" FontWeight="Bold"/>
        
        <!-- List of data -->
        <ListBox ItemsSource="{Binding FoundFiles}" Height="200">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="Mutate data" 
                Command="{Binding MutateFilesCommand}" 
                Background="DarkSlateBlue" Foreground="White" />
        
    </StackPanel>
</Window>
